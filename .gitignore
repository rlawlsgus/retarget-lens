# motion data and generated outputs stay out of git (docs/data.md)
data/
reports/
*.usd
*.usda
*.usdc
!assets/**/*.usd*

# body-model files are licence-gated (SMPL / SMPL-X / MANO)
models/

# packaging output (scripts\build_retlens.ps1, scripts\package_release.ps1)
/build/
/dist/

# internal project documents (kick-off deck, plan): not for the repository, and the deck
# is over GitHub's 100 MB file limit
/docs/internal/
/*.pptx
/*.pdf

# machine-specific Claude Code settings (launch.json has local paths); the project's skills are shared
.claude/*
!.claude/skills/

__pycache__/
*.pyc
.pytest_cache/
.vscode/
