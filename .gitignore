# motion data and generated outputs stay out of git
data/
reports/
*.usd
*.usda
*.usdc
!assets/**/*.usd*

# body-model files are licence-gated (SMPL / SMPL-X / MANO)
models/

# 자동 라벨 rule files are a project's own (often private) label definitions: only the example is shared
configs/label_rules*
*.rules.yaml
*.rules.yml
*.rules.json
*_subtask.yaml
*_subtask.yml
*_subtask.json
!configs/label_rules_example.yaml

# packaging output (scripts\build_retlens.ps1, scripts\package_release.ps1)
/build/
/dist/

# machine-specific Claude Code settings (launch.json has local paths); the project's skills are shared
.claude/*
!.claude/skills/

__pycache__/
*.pyc
.pytest_cache/
.vscode/
